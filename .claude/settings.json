{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4"
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run preview *)",
      "Bash(npm run test:e2e *)",
      "Bash(npm run test:e2e)",
      "Bash(npm run verify *)",
      "Bash(npm run verify)",
      "Bash(npm run agents:reset-locks)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright test)",
      "Bash(npx playwright show-report *)",
      "Bash(playwright-cli *)",
      "Bash(node .claude/skills/design-taste-frontend/scripts/* *)",
      "Bash(bash .claude/skills/awesome-design/scripts/fetch-design.sh *)",
      "Bash(node .claude/hooks/ownership-guard.mjs *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(npm ls *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(vercel *)",
      "Bash(rm -rf *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard origin*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ownership-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ownership-guard.mjs\" --release",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
