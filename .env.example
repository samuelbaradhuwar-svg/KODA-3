# Free website check (api/audit.js). Set these in Vercel: Project, Settings, Environment Variables.
RESEND_API_KEY=            # from resend.com (free tier is enough to start)
AUDIT_MODE=review          # review: reports go to KODA only. live: visitor sees results and gets the email too
AUDIT_NOTIFY_TO=samuelbaradhuwar@gmail.com   # interim; switch to info@heykoda.co.za later
AUDIT_FROM="KODA Audits <audit@heykoda.co.za>"   # needs the domain verified in Resend; until then leave unset
PAGESPEED_API_KEY=         # optional, free from Google Cloud; avoids Google's shared rate limit
ANTHROPIC_API_KEY=       # optional: turns on the AI-written summary at the top of each report
AUDIT_AI_MODEL=claude-haiku-5-5

# KODA Autopilot (see docs/AUTOPILOT-SETUP.md). Set these in Vercel: Project, Settings, Environment Variables.
# NEVER commit real values. The service role key and the secrets below must only ever live in Vercel.
SUPABASE_URL=                   # from the Supabase project: Settings, API
SUPABASE_SERVICE_ROLE_KEY=      # server only. Full database access. Never put this in a VITE_ variable
VITE_SUPABASE_URL=              # same URL, exposed to the admin page in the browser (public by design)
VITE_SUPABASE_ANON_KEY=         # the public anon key (public by design; the database only lets admins read)
AUTOPILOT_ENC_KEY=              # 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTOPILOT_ENC_KEY_VERSION=1
APPROVAL_LINK_SECRET=           # long random string; signs the approve/reject links in emails
CRON_SECRET=                    # long random string; the tick endpoint refuses calls without it (Vercel Cron sends it automatically)
ADMIN_EMAIL=                    # where approval emails go. Must also be added to ap_admins and created in Supabase Auth
APP_BASE_URL=https://www.heykoda.co.za
AUTOPILOT_FROM="KODA Autopilot <autopilot@heykoda.co.za>"   # needs the domain verified in Resend; until then leave unset
AUTOPILOT_DRY_RUN=1             # 1: tasks run their draft and approval steps but never execute anything outside the database. Start here
PAYFAST_MERCHANT_ID=            # billing: use the SANDBOX values first
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=1               # 1 while testing
